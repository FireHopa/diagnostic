# ===============================
# DIAGNÓSTICO IA 4Q's - PRODUÇÃO
# ===============================

# Porta interna do backend Node na VPS.
# Use uma porta livre. Recomendo 3010 para não bater com outros projetos.
PORT=3010

# Troque pelo subdomínio real que você vai usar.
# Exemplo: https://diagnostico.seudominio.com.br
FRONTEND_URL=https://diagnostico.seudominio.com.br

# Produção
NODE_ENV=production

# ===============================
# OPENAI
# ===============================
# Coloque sua chave real aqui na VPS.
# Nunca publique essa chave no GitHub e nunca coloque no front-end.
OPENAI_API_KEY=COLE_SUA_CHAVE_OPENAI_AQUI

# Modelo usado para gerar o diagnóstico.
# Se sua conta não tiver acesso a este modelo, troque por outro modelo disponível na sua conta.
OPENAI_MODEL=gpt-5.5

# low = mais rápido e mais barato
# medium = análise mais completa, mas demora mais
# high = mais profundo, maior custo e latência
OPENAI_SEARCH_CONTEXT_SIZE=low

# required = obriga pesquisa na web
# auto = deixa o modelo decidir se pesquisa ou não
OPENAI_TOOL_CHOICE=required

# low = mais rápido e barato
# medium/high = mais raciocínio, mais custo e demora
OPENAI_REASONING_EFFORT=low

# Configurações específicas do diagnóstico de reputação.
# Se omitidas, o sistema reutiliza as configurações gerais acima.
OPENAI_REPUTACAO_SEARCH_CONTEXT_SIZE=medium
OPENAI_REPUTACAO_REASONING_EFFORT=medium

# ===============================
# WEBHOOK OPCIONAL
# ===============================
# Use depois para enviar o lead para CRM, Make, N8N, WhatsApp etc.
WEBHOOK_URL=

# ===============================
# LIMITADOR DE USO
# ===============================
# Bloqueia repetição do MESMO tipo de diagnóstico por X dias.
# Recomendação: tipo + WhatsApp + empresa + cidade + segmento.
# Reputação: tipo + WhatsApp + empresa + cidade.
# Use 0 para bloquear para sempre enquanto o lead existir no backend.
DIAGNOSTICO_DUPLICATE_BLOCK_DAYS=30
